{
  "name": "remix-website",
  "version": "30.1.0",
  "private": true,
  "description": "",
  "license": "",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=44100 node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch --import remix/node-tsx server.ts",
    "hmr": "cross-env NODE_ENV=development PORT=44100 node hmr.ts",
    "format": "prettier --write ./",
    "deploy": "flyctl deploy --remote-only --config ./fly.production.toml --strategy rolling",
    "push:stage": "git tag -f stage && git push origin stage -f",
    "browser": "playwright-cli",
    "start": "cross-env NODE_ENV=production node --import remix/node-tsx server.ts",
    "preview": "cross-env NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.local --import remix/node-tsx server.ts",
    "validate": "pnpm remix doctor --strict && pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "cross-env NODE_ENV=test remix test",
    "test:ci": "cross-env NODE_ENV=test remix test --concurrency 1",
    "test:coverage": "cross-env NODE_ENV=test remix test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remix-run/ui": "0.13.1",
    "@shopify/storefront-api-client": "1.0.10",
    "cross-env": "10.1.0",
    "emoji-regex": "10.6.0",
    "fathom-client": "3.7.2",
    "feed": "4.2.2",
    "lru-cache": "10.4.3",
    "parse-numeric-range": "1.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remix": "3.2.0",
    "satori": "0.26.0",
    "semver": "7.7.4",
    "sharp": "0.35.3",
    "shiki": "4.5.0",
    "three": "0.184.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.23",
    "@playwright/test": "1.64.1",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.13",
    "@types/semver": "7.7.1",
    "@types/three": "0.184.0",
    "@types/unist": "3.0.3",
    "oxlint": "1.50.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vfile": "6.0.3"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "overrides": {
      "svgo": "3.3.3"
    }
  }
}
